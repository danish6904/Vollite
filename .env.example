# Flask Configuration
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-change-this-in-production

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/vollite_db

# Application Settings
DEBUG=False
PORT=5000

# Upload Settings
MAX_CONTENT_LENGTH=104857600  # 100MB in bytes

# CORS Settings
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Volatility Settings (optional)
VOLATILITY_PATH=/usr/local/bin/vol.py

# Groq Cloud LLM (free key at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
RAG_MODEL=llama-3.3-70b-versatile

# Redis (for background jobs via RQ)
# If Redis is not available, analysis runs synchronously (no setup needed)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=0.2
# REDIS_PASSWORD=

# Logging / monitoring
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3

# Security hardening
AUTH_REGISTER_RATE_LIMIT=30 per minute
AUTH_LOGIN_RATE_LIMIT=30 per minute
AUTH_CHANGE_PASSWORD_RATE_LIMIT=20 per minute
AUTH_VERIFY_TOKEN_RATE_LIMIT=120 per minute
RATELIMIT_STORAGE_URI=memory://
